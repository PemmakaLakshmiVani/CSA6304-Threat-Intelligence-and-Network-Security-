
def classify_stage(activity):
    activity = activity.lower()

    if "requirement" in activity or "objective" in activity:
        return "Direction"

    elif "gather" in activity or "collect" in activity:
        return "Collection"

    elif "clean" in activity or "format" in activity:
        return "Processing"

    elif "analyze" in activity or "investigate" in activity:
        return "Analysis"

    elif "share" in activity or "report" in activity:
        return "Dissemination"

    elif "feedback" in activity or "improve" in activity:
        return "Feedback"

    else:
        return "Unknown Stage"


activity = input("Enter intelligence activity: ")

stage = classify_stage(activity)

print("Lifecycle Stage:", stage)
